---
// ფოტოების გალერეა. ტელეფონზე: ჰორიზონტალურად გადასაფურცლი ზოლი (scroll-snap, JS-ის გარეშე).
// Desktop-ზე: ოთხი ფოტო ერთ რიგში, ოდნავ აცდენილი სიმაღლეებით.
// ახალი ფოტოს დასამატებლად: ფაილი src/assets/-ში, იმპორტი src/config/images.ts-ში და ერთი ჩანაწერი ქვემოთ.
import { Picture } from 'astro:assets';
import { images, type ImageKey } from '../config/images';

const photos: { image: ImageKey; alt: string }[] = [
  { image: 'gallery1', alt: 'სპაგეტი არაბიატას სოუსით თეფშზე, ზემოდან ყველი ეყრება; გვერდით პრეპოს არაბიატას კონტეინერი' },
  { image: 'gallery2', alt: 'მოხარშული სპაგეტი გადადის ქვაბში, სადაც არაბიატას სოუსია; უკან პრეპოს კონტეინერი' },
  { image: 'gallery3', alt: 'რიგატონი არაბიატას სოუსით და რიკოტათი თეფშზე; გვერდით პრეპოს არაბიატას კონტეინერი' },
  { image: 'gallery4', alt: 'რიგატონი არაბიატას სოუსით ქვაბიდან თეფშზე გადადის; წინ პრეპოს გახსნილი კონტეინერი' },
];
---

<section id="gallery" class="pb-16 lg:pb-24" aria-labelledby="gallery-title">
  <div class="container-page">
    <span class="eyebrow bg-prepo-red text-cream">გალერეა</span>
    <h2 id="gallery-title">პრეპო სამზარეულოში</h2>
  </div>

  <ul
    class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:px-6 md:mx-auto md:grid md:max-w-page md:grid-cols-4 md:gap-5 md:overflow-visible md:pb-0 lg:px-8"
    tabindex="0"
    aria-label="ფოტოების გალერეა"
  >
    {
      photos.map((photo, index) => (
        <li class:list={['w-[72vw] max-w-[20rem] shrink-0 snap-center md:w-auto md:max-w-none', index % 2 === 1 && 'md:mt-10']} data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <Picture
            src={images[photo.image]}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={[320, 480, 640, 900]}
            sizes="(min-width: 768px) 270px, 72vw"
            loading="lazy"
            decoding="async"
            class="aspect-[2/3] w-full rounded-card object-cover shadow-soft lg:rounded-card-lg"
          />
        </li>
      ))
    }
  </ul>
</section>
