---
import { Picture } from 'astro:assets';
import Sticker from './Sticker.astro';
import { images } from '../config/images';

const reasons: { title: string; text?: string }[] = [
  { title: 'ნამდვილი რეცეპტი', text: 'ავთენტური იტალიური სოუსი' },
  { title: 'არც დაჭრა, არც მოშუშვა', text: 'ყველაფერი უკვე გაკეთებულია.' },
  { title: 'ნაკლები გასარეცხი ჭურჭელი' },
  { title: 'მზადდება 5 წუთში' },
];
---

<section id="why" class="bg-prepo-red py-16 text-cream lg:py-24" aria-labelledby="why-title">
  <div class="container-page grid items-center gap-10 lg:grid-cols-[1fr_0.8fr] lg:gap-16">
    <div>
      <span class="eyebrow bg-cream text-dark-red">რატომ პრეპო</span>
      <h2 id="why-title">არ იცი მზარეულობა? არც გჭირდება.</h2>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          reasons.map((reason, index) => (
            <li class="rounded-card bg-cream p-5 text-dark-red" data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <h3 class:list={[reason.text ? 'mb-2' : 'mb-0', 'text-prepo-red']}>{reason.title}</h3>
              {reason.text && <p class="mb-0">{reason.text}</p>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div data-reveal>
        <Picture
          src={images.promoIngredients}
          alt="არაბიატას და პესტოს კონტეინერები მაგიდაზე, გარშემო პომიდორი, წიწაკა, ბაზილიკი, ზეითუნის ზეთი და ყველი"
          formats={['avif', 'webp']}
          widths={[400, 640, 900, 1080]}
          sizes="(min-width: 1024px) 460px, 92vw"
          loading="lazy"
          decoding="async"
          class="aspect-square w-full rounded-card-lg object-cover lg:rounded-card-xl"
        />
      </div>
      <Sticker image="mascotArrabbiata" alt="" tilt={-9} size={170} class="absolute -bottom-10 -left-2 w-32 sm:w-40 lg:-left-12" />
    </div>
  </div>
</section>
