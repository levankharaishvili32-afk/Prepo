---
// ერთი გემოს ბარათი. ფერი მოდის site.ts-დან (flavor.color).
// ფერად ფონზე მხოლოდ დიდი/მსხვილი კრემისფერი ტექსტია (მწვანეზე პატარა ტექსტი AA-ს ვერ აკმაყოფილებს);
// წვრილი ტექსტი კრემისფერ შიდა ბარათშია.
import OrderButton from './OrderButton.astro';
import Sticker from './Sticker.astro';
import { site, type Flavor } from '../config/site';

interface Props {
  flavor: Flavor;
  index: number;
}

const { flavor, index } = Astro.props;
const tilt = index % 2 === 0 ? -7 : 7;
---

<article
  class="relative flex flex-col rounded-card-lg px-5 pb-5 pt-6 text-cream sm:px-7 sm:pb-7 lg:rounded-card-xl"
  style={`background-color:${flavor.color};--reveal-delay:${index * 120}ms`}
  data-reveal
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 pt-2">
      <h3 class="font-black leading-none" style="font-size: clamp(1.9rem, 1.2rem + 3.4vw, 3.25rem)">{flavor.name}</h3>
      {flavor.tagline && <p class="mt-3 text-2xl font-extrabold leading-tight">{flavor.tagline}</p>}
    </div>
    {
      flavor.mascot && (
        <Sticker image={flavor.mascot} alt={flavor.mascotAlt ?? ''} tilt={tilt} size={170} reveal={false} class="-mr-2 -mt-14 w-24 shrink-0 sm:w-40" />
      )
    }
  </div>

  <div class="mt-5 flex flex-1 flex-col rounded-card bg-cream p-5 text-dark-red">
    {flavor.description && <p class="text-lg leading-relaxed">{flavor.description}</p>}
    {
      flavor.ingredients && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="ძირითადი შემადგენლობა">
          {flavor.ingredients.map((item) => (
            <li class="rounded-full border-2 border-dark-red/20 px-3 py-1 text-sm font-bold">{item}</li>
          ))}
        </ul>
      )
    }
    {
      site.price !== null && (
        <p class="mt-5 text-3xl font-black">
          {site.price} ₾
        </p>
      )
    }
  </div>

  <OrderButton variant="cream" flavor={flavor.id} class="mt-5 w-full" />
</article>
