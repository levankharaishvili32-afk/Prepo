---
// ერთი გემოს ბარათი. ფერი მოდის site.ts-დან (flavor.color).
// ტიპოგრაფია (TYPOGRAPHY.md): გემოს სახელი ტექსტია, h3 ტეგით, სექციის სათაურის ზომით და 900 წონით.
// ფერად ფონზე მხოლოდ დიდი/მსხვილი კრემისფერი ტექსტია (მწვანეზე პატარა ტექსტი AA-ს ვერ აკმაყოფილებს);
// ძირითადი ტექსტი კრემისფერ შიდა ბარათშია.
import OrderButton from './OrderButton.astro';
import Sticker from './Sticker.astro';
import { site, type Flavor } from '../config/site';

interface Props {
  flavor: Flavor;
  index: number;
}

const { flavor, index } = Astro.props;
const tilt = index % 2 === 0 ? -7 : 7;
---

<article
  class="relative flex flex-col rounded-card-lg px-5 pb-5 pt-9 text-cream sm:px-7 sm:pb-7 lg:rounded-card-xl"
  style={`background-color:${flavor.color};--reveal-delay:${index * 120}ms`}
  data-reveal
>
  {
    flavor.mascot && (
      <Sticker
        image={flavor.mascot}
        alt={flavor.mascotAlt ?? ''}
        tilt={tilt}
        size={170}
        reveal={false}
        class="absolute -top-16 right-2 w-24 sm:-top-12 sm:right-4 sm:w-36"
      />
    )
  }
  <h3 class="h2 mb-2 font-black sm:pr-36">{flavor.name}</h3>
  {flavor.tagline && <p class="h3 mb-0 sm:pr-36">{flavor.tagline}</p>}

  <div class="mt-5 flex flex-1 flex-col rounded-card bg-cream p-5 text-dark-red">
    {flavor.description && <p class="mb-0">{flavor.description}</p>}
    {
      flavor.ingredients && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="ძირითადი შემადგენლობა">
          {flavor.ingredients.map((item) => (
            <li class="small rounded-full border-2 border-dark-red/20 px-3 py-1 font-bold">{item}</li>
          ))}
        </ul>
      )
    }
    {site.price !== null && <p class="price mb-0 mt-5">{site.price} ₾</p>}
  </div>

  <OrderButton variant="cream" flavor={flavor.id} class="mt-5 w-full" />
</article>
