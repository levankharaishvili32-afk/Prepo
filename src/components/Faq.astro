---
// ჩანს მხოლოდ ის კითხვები, რომლებსაც site.ts-ში პასუხი აქვთ. თუ არცერთს არ აქვს, სექცია იმალება.
// Accordion მუშაობს JS-ის გარეშე: <details name="faq"> ერთდროულად ერთს ხსნის.
import { site } from '../config/site';

const items = site.faq.filter((item) => item.answer);
---

{
  items.length > 0 && (
    <section id="faq" class="pb-16 lg:pb-24" aria-labelledby="faq-title">
      <div class="container-page max-w-3xl">
        <span class="eyebrow bg-dark-red text-cream">კითხვები</span>
        <h2 id="faq-title">ხშირი კითხვები</h2>

        <div class="mt-6 space-y-3">
          {items.map((item) => (
            <details name="faq" class="group rounded-card border-2 border-dark-red/15 open:border-prepo-red">
              <summary class="h3 flex min-h-[3.5rem] items-center justify-between gap-4 rounded-card px-5 py-4">
                {item.question}
                <span class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-prepo-red text-cream transition-transform duration-200" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M8 2v12M2 8h12" />
                  </svg>
                </span>
              </summary>
              <p class="mb-0 px-5 pb-5">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
