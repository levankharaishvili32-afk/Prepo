---
import { Picture } from 'astro:assets';
import { images } from '../config/images';

// ნაბიჯებს მხოლოდ სათაური აქვს (მფლობელის ტექსტი)
const steps = ['მოხარშე პასტა', 'ჩააგდე მოხარშულ პასტაში Prepo-ს სოუსი', 'მიირთვი'];
---

<section id="how" class="py-16 lg:py-24" aria-labelledby="how-title">
  <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div data-reveal>
      <Picture
        src={images.promoKitchen}
        alt="სამზარეულოში კონტეინერიდან გაყინული არაბიატას სოუსი ტაფაში, პასტაზე ვარდება"
        formats={['avif', 'webp']}
        widths={[400, 640, 900, 1080]}
        sizes="(min-width: 1024px) 520px, 92vw"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full rounded-card-lg object-cover shadow-soft lg:rounded-card-xl"
      />
    </div>

    <div>
      <h2 id="how-title">მომზადების წესი</h2>

      <ol class="mt-6 space-y-4">
        {
          steps.map((step, index) => (
            <li class="flex items-center gap-4 rounded-card border-2 border-dark-red/15 p-5" data-reveal style={`--reveal-delay:${index * 90}ms`}>
              <span class="h3 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-prepo-red text-cream" aria-hidden="true">
                {index + 1}
              </span>
              <h3 class="mb-0">{step}</h3>
            </li>
          ))
        }
      </ol>
      <p class="mb-0 mt-6 text-prepo-red"><strong>Prepo-ს თითო შეფუთვა განკუთვნილია ორი პორციისთვის</strong></p>
    </div>
  </div>
</section>
