---
// სოც. ქსელები, კონტაქტი და იურიდიული ტექსტი ჩანს მხოლოდ მაშინ, როცა site.ts-ში შევსებულია.
import Logo from './Logo.astro';
import { site } from '../config/site';

// აიქონები: მარტივი ერთფერიანი SVG-ები (currentColor), გარე ფაილების გარეშე.
const icons = {
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="7" r="1.3" fill="currentColor"/>',
  facebook:
    '<path fill="currentColor" d="M13.6 21v-7.6h2.5l.4-3h-2.9V8.5c0-.9.3-1.5 1.6-1.5h1.5V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.5V21h3.1z"/>',
  tiktok:
    '<path fill="currentColor" d="M16.2 3h-3.1v12.3a2.5 2.5 0 1 1-2.5-2.5c.25 0 .5.04.75.1V9.75a5.6 5.6 0 1 0 4.85 5.55V9.2a7.1 7.1 0 0 0 4.1 1.3V7.4a4.1 4.1 0 0 1-4.1-4.4z"/>',
};

const socials = [
  site.instagramUrl && { label: 'Instagram', href: site.instagramUrl, icon: icons.instagram },
  site.facebookUrl && { label: 'Facebook', href: site.facebookUrl, icon: icons.facebook },
  site.tiktokUrl && { label: 'TikTok', href: site.tiktokUrl, icon: icons.tiktok },
].filter(Boolean) as { label: string; href: string; icon: string }[];

const contacts = [
  site.phone && { label: site.phone, href: `tel:${site.phone.replace(/[^+\d]/g, '')}` },
  site.email && { label: site.email, href: `mailto:${site.email}` },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="bg-dark-red py-12 text-cream">
  <div class="container-page flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div>
      <Logo variant="cream" height={44} />
      <p class="lead mb-0 mt-4 font-bold">გახსენი. ჩააგდე. მიირთვი.</p>
    </div>

    {
      (socials.length > 0 || contacts.length > 0) && (
        <div class="flex flex-col gap-6 font-bold sm:flex-row sm:gap-14">
          {socials.length > 0 && (
            <ul class="flex gap-3" aria-label="სოციალური ქსელები">
              {socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-cream/40 transition-colors hover:bg-cream hover:text-dark-red"
                    target="_blank"
                    rel="noopener"
                    aria-label={`Prepo — ${social.label}`}
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" set:html={social.icon} />
                  </a>
                </li>
              ))}
            </ul>
          )}
          {contacts.length > 0 && (
            <ul class="space-y-2" aria-label="კონტაქტი">
              {contacts.map((contact) => (
                <li>
                  <a href={contact.href} class="underline underline-offset-4">
                    {contact.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>

  <div class="small container-page mt-10 border-t-2 border-cream/20 pt-6">
    {site.legalText && <p class="mb-2">{site.legalText}</p>}
    <p class="mb-0">© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
