---
// ყველა „შეუკვეთე“ ღილაკი ამ კომპონენტით იხატება.
// სად მიდის (იხ. orderHref, src/config/site.ts):
// - orderUrl შევსებულია     -> გარე ბმული (ახალ ჩანართში);
// - ფორმა ჩართულია          -> /order გვერდი (გემოს ბარათიდან: /order?flavor=pesto, გემო წინასწარ ირჩევა);
// - არცერთი                 -> მთავარი გვერდის შეკვეთის სექცია (#order).
// data-order / data-flavor ატრიბუტებს Meta Pixel-ის Lead ივენთი იყენებს (src/lib/pixel.ts).
import { site, orderHref } from '../config/site';

interface Props {
  label?: string;
  flavor?: string;
  variant?: 'red' | 'cream';
  class?: string;
}

const { label = 'შეუკვეთე ახლავე', flavor, variant = 'red', class: className = '' } = Astro.props;
const external = Boolean(site.orderUrl);
const href = !external && site.orderFormKey && flavor ? `${orderHref}?flavor=${flavor}` : orderHref;
---

<a
  href={href}
  class:list={['btn', variant === 'red' ? 'btn-red' : 'btn-cream', className]}
  data-order
  data-flavor={flavor}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  {label}
</a>
