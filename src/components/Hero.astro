---
// მობილურზე: ფოტო ზემოთ, ტექსტი მის ქვემოთ წითელ ბარათში (ოდნავ ადის ფოტოზე).
// Desktop-ზე: ტექსტი მარცხნივ, ფოტო მომრგვალებულ ჩარჩოში მარჯვნივ.
// ტიპოგრაფია: სლოგანი = .display (40 → 84px), ქვესათაური = .lead — იხ. TYPOGRAPHY.md
import HeroImage from './HeroImage.astro';
import OrderButton from './OrderButton.astro';
import Sticker from './Sticker.astro';
---

<section class="relative isolate lg:py-14" aria-labelledby="hero-title">
  <div class="lg:container-page lg:grid lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
    <div class="relative lg:order-2 lg:justify-self-center">
      <div class="aspect-[5/4] w-full overflow-hidden bg-dark-red sm:aspect-[16/10] lg:aspect-[9/16] lg:h-[min(76vh,700px)] lg:w-auto lg:rounded-card-xl lg:shadow-soft">
        <HeroImage />
      </div>
      <!-- desktop-ზე მასკოტი ფოტოს ჩარჩოს კუთხეშია (იგივე სურათის ფაილი, მეორედ არ იტვირთება) -->
      <Sticker image="mascotSitting" alt="" tilt={-8} size={180} float reveal={false} eager class="absolute -bottom-8 -left-16 hidden w-36 lg:block" />
    </div>

    <div class="relative -mt-12 p-3 lg:order-1 lg:mt-0 lg:p-0">
      <div class="relative rounded-card bg-prepo-red px-5 pb-6 pt-7 text-cream lg:bg-transparent lg:p-0 lg:text-dark-red">
        <Sticker
          image="mascotSitting"
          alt="პრეპოს პერსონაჟი: წითელი სოუსის კუბი ზის და ხელს გიქნევს"
          tilt={8}
          size={180}
          float
          reveal={false}
          eager
          class="absolute -top-24 right-1 w-28 lg:hidden"
        />
        <!-- H1 საკვანძო სიტყვაა (SEO); ვიზუალურად ზედა წარწერაა. დიდი სლოგანი ჩვეულებრივი ტექსტია display ზომით. -->
        <h1 id="hero-title" class="eyebrow bg-cream text-dark-red lg:bg-prepo-red lg:text-cream">პასტის სოუსები</h1>
        <p class="display mb-[0.4em] max-w-none">რესტორნის გემო სახლში, წუთებში</p>
        <p class="lead max-w-xl">
          პრეპო ნამდვილი იტალიური სოუსია, უკვე მომზადებული და გაყინული. შენ მხოლოდ პასტა მოხარშე. დანარჩენი ჩვენ უკვე გავაკეთეთ.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:mt-8">
          <OrderButton variant="cream" class="lg:!bg-prepo-red lg:!text-cream" />
          <a href="#how" class="btn btn-ghost">გაიგე მეტი</a>
        </div>
      </div>
    </div>
  </div>
</section>
