---
// მობილურზე: ვიდეო მთელ ეკრანზე, ტექსტი ქვემოთ წითელ ბარათში.
// Desktop-ზე: ტექსტი მარცხნივ, ვიდეო მომრგვალებულ ჩარჩოში მარჯვნივ.
import HeroVideo from './HeroVideo.astro';
import OrderButton from './OrderButton.astro';
import Sticker from './Sticker.astro';
---

<section class="relative isolate lg:py-14" aria-labelledby="hero-title">
  <div class="lg:container-page lg:grid lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
    <div class="absolute inset-0 -z-10 lg:relative lg:inset-auto lg:z-0 lg:order-2 lg:justify-self-center">
      <div class="h-full w-full lg:aspect-[9/16] lg:h-[min(76vh,700px)] lg:w-auto lg:overflow-hidden lg:rounded-card-xl lg:shadow-soft">
        <HeroVideo />
      </div>
    </div>

    <div class="flex min-h-[max(calc(100svh-4rem),38rem)] flex-col justify-end p-3 lg:order-1 lg:min-h-0 lg:p-0">
      <div class="relative rounded-card bg-prepo-red px-5 pb-6 pt-7 text-cream lg:bg-transparent lg:p-0 lg:text-dark-red">
        <Sticker
          image="mascotSitting"
          alt="პრეპოს პერსონაჟი: წითელი სოუსის კუბი ზის და ხელს გიქნევს"
          tilt={8}
          size={180}
          float
          reveal={false}
          eager
          class="absolute -top-24 right-1 w-28 lg:-bottom-44 lg:left-[58%] lg:right-auto lg:top-auto lg:w-44"
        />
        <h1 id="hero-title" class="pr-2 font-black leading-[1.05] lg:pr-0" style="font-size: clamp(2rem, 1.1rem + 4.6vw, 4.5rem)">
          რესტორნის გემო სახლში, წუთებში
        </h1>
        <p class="mt-4 max-w-xl text-base font-semibold leading-relaxed lg:mt-6 lg:text-xl">
          პრეპო ნამდვილი იტალიური სოუსია, უკვე მომზადებული და გაყინული. შენ მხოლოდ პასტა მოხარშე. დანარჩენი ჩვენ უკვე გავაკეთეთ.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:mt-8">
          <OrderButton variant="cream" class="lg:!bg-prepo-red lg:!text-cream" />
          <a href="#how" class="btn btn-ghost">გაიგე მეტი</a>
        </div>
      </div>
    </div>
  </div>
</section>
