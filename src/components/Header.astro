---
import Logo from './Logo.astro';
import OrderButton from './OrderButton.astro';
import { site } from '../config/site';

const hasFaq = site.faq.some((item) => item.answer);
const links = [
  { href: '/#how', label: 'როგორ მუშაობს' },
  { href: '/#flavors', label: 'გემოები' },
  { href: '/#why', label: 'რატომ პრეპო' },
  { href: '/#packaging', label: 'შეფუთვა' },
  ...(hasFaq ? [{ href: '/#faq', label: 'კითხვები' }] : []),
];
---

<header class="sticky top-0 z-40 bg-cream">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href="/" class="shrink-0 rounded-full" aria-label="Prepo — მთავარი გვერდი">
      <Logo height={32} eager />
    </a>

    <nav class="hidden items-center gap-7 font-bold lg:flex" aria-label="მთავარი მენიუ">
      {links.map((link) => <a href={link.href} class="rounded-full underline-offset-8 hover:underline">{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <OrderButton label="შეუკვეთე" class="!min-h-[2.75rem] !px-5 !py-2 !shadow-none" />
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-dark-red lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">მენიუ</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t-2 border-dark-red/10 bg-cream lg:hidden" aria-label="მობილური მენიუ">
    <ul class="h3 container-page flex flex-col py-3">
      {links.map((link) => (
        <li>
          <a href={link.href} class="block rounded-card px-3 py-3">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
